{
  "version": 8,
  "name": "AURELIS Dark",
  "metadata": {
    "aurelis:derived-from": "OpenFreeMap 'dark' style (https://tiles.openfreemap.org/styles/dark), github.com/hyperknot/openfreemap-styles, MIT; based on OpenMapTiles styles, design CC BY 4.0",
    "aurelis:changes": "Recolored to AURELIS palette; removed sprite, icons, patterns, one-way arrows and the unused Natural Earth raster source. Label hierarchy by zoom (Etapa 4C): states from z4.5, national capitals from z2.8, large cities z4, motorways fade in z5.5-6, capitals above states, cities z5.5, towns z7, villages z9; subnational boundaries fade in z3-6."
  },
